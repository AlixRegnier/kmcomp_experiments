Bootstrap: docker
From: debian:bookworm
#
%post
	apt update
	apt upgrade -y
	apt install -y libboost-all-dev libbz2-dev libc6-dev
	apt install -y build-essential autoconf automake autopoint gettext po4a doxygen libtool cmake zlib1g-dev python3 python3-pip python3-venv git libssl-dev zstd wget curl

	#Tools
	apt install -y time xxd nano bc

%environment
	NORMAL="\[\e[0m\]"
	CYAN="\[\e[1;96m\]"

    export PS1="$CYAN[$NORMAL\w$CYAN] ($APPTAINER_NAME)\$ $NORMAL"
	alias python=python3
	alias pip=pip3
	alias nano="nano -m"

%runscript
	ulimit -n 500000

%labels
	Author alix.regnier@inria.fr

%help
	This is a container used to compile kmindex, kmcomp
